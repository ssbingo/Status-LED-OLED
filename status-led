#!/usr/bin/env bash
#
# Kleiner Komfort-Wrapper fuer die haeufigen Aufgaben.
# Wird von install.sh nach /usr/local/bin/status-led kopiert.

set -euo pipefail

INSTALL_DIR="/opt/status-led"
VENV_PY="$INSTALL_DIR/venv/bin/python"
CONFIG_FILE="/etc/status-led/config.toml"

usage() {
    cat <<EOF
status-led - Verwaltung der Status-LED + OLED

Verwendung: status-led <befehl>

  setup         Konfigurations-Assistent (schreibt $CONFIG_FILE)
  update        auf die neueste Version aktualisieren
  status        Dienststatus anzeigen
  logs          Live-Log anzeigen (Strg+C beendet)
  restart       Dienst neu starten
  diag          Hardware-Diagnose (OLED/SMART/Luefter)
  backup        jetzt ein Backup ausfuehren
  backup-setup  Backup einrichten/aendern (restic)
  backup-status Backup-Zeitplan und letztes Log anzeigen
  restore       Daten aus dem Backup wiederherstellen (Assistent)
  web           Web-Dashboard: Adresse und Status anzeigen
  web-setup     Web-Dashboard einrichten/aendern
  version       installierte Version anzeigen
EOF
}

backup_ready() { [ -f /etc/systemd/system/status-led-backup.service ]; }
web_ready()    { [ -f /etc/systemd/system/status-led-web.service ]; }

case "${1:-}" in
    setup)   exec sudo "$VENV_PY" "$INSTALL_DIR/status_led.py" --setup --config "$CONFIG_FILE" ;;
    update)  exec sudo "$INSTALL_DIR/update.sh" ;;
    status)  exec systemctl status status-led.service ;;
    logs)    exec journalctl -u status-led -f ;;
    restart) exec sudo systemctl restart status-led.service ;;
    diag)    exec sudo "$VENV_PY" "$INSTALL_DIR/status_led.py" --diag --config "$CONFIG_FILE" ;;
    backup)
        if backup_ready; then
            sudo systemctl start status-led-backup.service
            journalctl -u status-led-backup -n 20 --no-pager
        else
            echo "Backup nicht eingerichtet - 'sudo status-led backup-setup' ausfuehren."; exit 1
        fi
        ;;
    backup-setup)  exec sudo "$INSTALL_DIR/setup-backup.sh" ;;
    restore)       exec sudo "$INSTALL_DIR/restore.sh" ;;
    web-setup)     exec sudo "$INSTALL_DIR/setup-web.sh" ;;
    web)
        if web_ready; then
            port="$(sed -n 's/^WEB_PORT=//p' /etc/status-led/web.env 2>/dev/null | head -1)"
            ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
            echo "Web-Dashboard: http://${ip:-<pi-ip>}:${port:-8080}/"
            systemctl status status-led-web.service --no-pager
        else
            echo "Web-Dashboard nicht eingerichtet - 'sudo status-led web-setup' ausfuehren."; exit 1
        fi
        ;;
    backup-status)
        if backup_ready; then
            systemctl list-timers status-led-backup.timer --no-pager || true
            echo
            journalctl -u status-led-backup -n 25 --no-pager
        else
            echo "Backup nicht eingerichtet - 'sudo status-led backup-setup' ausfuehren."; exit 1
        fi
        ;;
    version) exec "$VENV_PY" "$INSTALL_DIR/status_led.py" --version ;;
    ""|-h|--help|help) usage ;;
    *) echo "Unbekannter Befehl: $1"; echo; usage; exit 1 ;;
esac
